---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicPill from '../../components/TopicPill.astro';
import Rating from '../../components/Rating.astro';
import Arrow from '../../components/Arrow.astro';
import { formatDate, getPosts, readingTime, summaryOf, type Post } from '../../lib/content';
import { topics } from '../../lib/topics';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    // Keep reading: same topic first, then the most recent of the rest.
    const others = posts.filter((p) => p.id !== post.id);
    const related = [
      ...others.filter((p) => p.data.topic === post.data.topic),
      ...others.filter((p) => p.data.topic !== post.data.topic),
    ].slice(0, 2);
    return { params: { slug: post.id }, props: { post, related } };
  });
}

const { post, related } = Astro.props as { post: Post; related: Post[] };
const { title, date, topic, summary, series, tags, rating, hero, heroAlt } = post.data;
const { Content } = await render(post);
---
<BaseLayout title={title} section="writing" description={summaryOf(post)}>
  <article class="post" data-topic={topic}>
    <header class="post-head">
      <a href="/posts" class="back mono"><Arrow direction="left" size={16} />all writing</a>
      <div class="meta">
        <TopicPill topic={topic} />
        <span class="mono muted">
          <time datetime={date.toISOString()}>{formatDate(date)}</time> · {readingTime(post.body)} min read
        </span>
        {rating !== undefined && <Rating topic={topic} value={rating} />}
      </div>
      <h1>{title}</h1>
      {summary && <p class="dek">{summary}</p>}
    </header>

    {hero && (
      <figure class="hero card">
        <Image src={hero} alt={heroAlt ?? ''} width={900} />
        {heroAlt && <figcaption class="mono">{heroAlt}</figcaption>}
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    <footer class="post-foot">
      <div class="filed">
        <span class="mono muted">filed under</span>
        <a href={`/topics/${topic}`} class="chip" data-topic={topic}>{topics[topic].label}</a>
        {series && <span class="chip" data-topic={topic}>{series}</span>}
        {tags.map((tag) => <span class="chip" data-topic={topic}>{tag}</span>)}
      </div>
      {related.length > 0 && (
        <>
          <h2>Keep reading</h2>
          <nav aria-label="More posts" class="related">
            {related.map((p) => (
              <a href={`/posts/${p.id}`} class="related-card card lift">
                <TopicPill topic={p.data.topic} size="small" />
                <span class="related-title">{p.data.title}</span>
              </a>
            ))}
          </nav>
        </>
      )}
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    display: flex;
    flex-direction: column;
    padding: 24px 0 88px;
  }
  .post-head {
    max-width: 820px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-bottom: 44px;
  }
  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 14px;
    text-decoration: none;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .meta .mono { font-size: 13px; }
  h1 {
    margin: 0;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1.03;
    letter-spacing: -0.035em;
    font-weight: 800;
    text-wrap: balance;
  }
  .dek {
    margin: 0;
    max-width: 640px;
    font-size: 22px;
    line-height: 1.45;
    color: var(--muted);
  }
  .hero {
    max-width: 900px;
    width: 100%;
    margin: 0 auto 56px;
    padding: clamp(20px, 4vw, 40px);
    border-radius: 28px;
    background: var(--t-bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .hero :global(img) { display: block; border-radius: 12px; }
  .hero figcaption {
    max-width: 560px;
    text-align: center;
    font-size: 14px;
    line-height: 1.6;
    color: var(--t-ink);
  }

  /* Article body: Literata at a 680px measure. */
  .prose {
    max-width: 680px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 26px;
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.75;
    overflow-wrap: break-word;
  }
  .prose :global(> *) { margin: 0; }
  .prose :global(h2),
  .prose :global(h3) {
    margin: 16px 0 0;
    font-family: var(--font-sans);
    font-size: 32px;
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 800;
    text-wrap: balance;
  }
  .prose :global(h4) {
    margin: 8px 0 0;
    font-family: var(--font-sans);
    font-size: 24px;
    line-height: 1.2;
    font-weight: 700;
  }
  .prose :global(ul),
  .prose :global(ol) { padding-left: 1.4em; display: flex; flex-direction: column; gap: 12px; }
  .prose :global(blockquote) {
    padding: 4px 0 4px 20px;
    border-left: 4px solid var(--t-bg);
    color: var(--muted);
    font-style: italic;
  }
  .prose :global(hr) { width: 100%; border: 0; border-top: 2px dashed var(--line); }
  .prose :global(a) { text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .prose :global(img) { border-radius: 12px; border: 2px solid var(--edge); }
  .prose :global(:not(pre) > code) {
    padding: 2px 7px;
    border-radius: 6px;
    background: var(--t-bg);
    color: var(--t-ink);
    font-family: var(--font-mono);
    font-size: 0.82em;
  }

  /* Code blocks: the dark card from the canvas, with a language bar and line numbers. */
  .prose :global(pre) {
    position: relative;
    padding: 58px 0 18px;
    border-radius: 18px;
    border: 2px solid var(--edge);
    box-shadow: 6px 6px 0 var(--shadow);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 14.5px;
    line-height: 1.7;
    counter-reset: line;
  }
  .prose :global(pre)::before {
    content: attr(data-language);
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: 12px 18px;
    border-bottom: 1px solid #3A3449;
    font-size: 13px;
    color: #B7B0C9;
  }
  .prose :global(pre code) { display: block; min-width: max-content; padding-right: 24px; }
  .prose :global(pre .line)::before {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 3ch;
    margin: 0 2ch;
    text-align: right;
    color: #857E99;
    user-select: none;
  }

  .post-foot {
    max-width: 680px;
    width: 100%;
    margin: 64px auto 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .filed {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    padding-top: 28px;
    border-top: 2px dashed var(--line);
  }
  .filed .mono { margin-right: 4px; font-size: 13px; }
  .post-foot h2 {
    margin: 12px 0 0;
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 800;
  }
  .related {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 20px;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 20px 22px;
    border-radius: 20px;
    box-shadow: 4px 4px 0 var(--shadow);
    text-decoration: none;
  }
  .related-title {
    font-size: 21px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    font-weight: 700;
  }
</style>
