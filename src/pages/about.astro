---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About" section="about" description="Who's writing this.">
  <section class="about">
    <div class="text">
      <p class="kicker">// about</p>
      <h1>Who <span class="hl" data-topic="philosophy">am I?</span></h1>
      <p>
        I'm Tomi Adenekan, a junior studying Computer Science + Philosophy at Penn. I love to
        workout, code, eat and I've been recently getting into playing ping pong. I love learning most things and 
        usually like an interesting challenge. You'll often find me working through the tons of homework I can never 
        seem to escape, thinking about philosophy, or playing ping pong.
      </p>
      <p>
        If you want to get in touch, send me an email at{' '}
        <a href="mailto:tominekan12@gmail.com">tominekan12@gmail.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: center;
    padding: 56px 0 96px;
  }
  .text {
    flex: 1 1 420px;
    min-width: 0;
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  h1 {
    margin: 0;
    font-size: clamp(42px, 6.4vw, 84px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 800;
  }
  .hl {
    display: inline-block;
    padding: 0 0.16em;
    border-radius: 0.18em;
    background: var(--t-bg);
    color: var(--t-ink);
    transform: rotate(calc(var(--tilt) * 1.5deg));
  }
  .text > p:not(.kicker) { margin: 0; font-size: 20px; line-height: 1.6; }
</style>
